{
  "name": "admissions-desk",
  "version": "1.0.0",
  "description": "MCP server (in progress) letting Aldermoor Schools admissions staff query inquiries across campuses through Claude.",
  "private": true,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json",
    "lint": "eslint src test",
    "verify": "pnpm typecheck && pnpm lint && pnpm build && pnpm test",
    "test": "vitest run",
    "db:reset": "supabase db reset",
    "gen:types": "supabase gen types typescript > src/db/types.ts"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.20.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^26.6.6",
    "eslint": "10.14.0",
    "supabase": "^3.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "postgres": "^4.0.0",
    "zod": "^4.6.7"
  }
}
