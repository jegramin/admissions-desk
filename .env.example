# MCP server connection. Must be the restricted admissions_app role, never
# postgres: row level security only applies to a role without BYPASSRLS.
# The password below is the local-only one set by the app-role migration.
DATABASE_URL=postgresql://admissions_app:admissions_app_local_only@127.0.0.1:55322/postgres

# Staff member the server acts as (a staff.id from the seed).
ADMISSIONS_STAFF_ID=00000000-0000-0000-0000-000000000001

# Admin connection for migrations, seeding and tests only. Never give this to
# the server. Tests refuse to run unless its host is local.
ADMIN_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
